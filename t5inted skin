    local function GetCustomSound(Weapon, Skin)
        if not Weapon or not Weapon.Handle then return nil end
        
        local ToolSounds = Sounds:FindFirstChild(Weapon.Name)
        if not ToolSounds then return nil end

        local ActualThing = ToolSounds:FindFirstChild(Skin)
        if not ActualThing then return nil end

        if Weapon.Name == '[RPG]' then
            ActualThing = ActualThing:FindFirstChild('Swoosh')
            if not ActualThing or (ActualThing and not ActualThing:IsA('ValueBase')) then 
                return nil
            end
        else
            if not ActualThing:IsA('ValueBase') then 
                return nil
            end
        end
        
        return ActualThing.Value
    end
    
    local function ResetToDefault(Weapon)
        if not Weapon then return end
        
        if Weapon.Name == "[Wallet]" then
            for _, x in Weapon.Default:GetDescendants() do 
                pcall(function() x:Destroy() end) 
            end
            Weapon.C1.Transparency = 0
            Weapon.C2.Transparency = 0
            Weapon.Default.Transparency = 0
            for i,v in Weapon.C1:GetChildren() do if v:IsA("Decal") then v.Transparency = 0 end end
            for i,v in Weapon.C2:GetChildren() do if v:IsA("Decal") then v.Transparency = 0 end end
        elseif Weapon.Name == "[Knife]" then
            StopKnifeAnimations(Weapon)
            if Weapon:FindFirstChild("Default") then
                Weapon.Default:ClearAllChildren()
                Weapon.Default.Transparency = 0
            end
        else
            if Weapon:FindFirstChild("Default") then
                Weapon.Default.Transparency = 0
                if OriginalTextures[Weapon.Name] then
                    Weapon.Default.TextureID = OriginalTextures[Weapon.Name]
                else
                    local DefaultGunModel = SkinAssets.Parent.SkinModules.GunModels:FindFirstChild(Weapon.Name)
                    if DefaultGunModel then
                        Weapon.Default.TextureID = DefaultGunModel.TextureID
                    end
                end
                for _, child in Weapon.Default:GetChildren() do
                    if child:IsA("MeshPart") and child.Name == "Mesh" then
                        child:Destroy()
                    end
                    if child:IsA("Weld") then
                        child:Destroy()
                    end
                end
            end
        end
        
        if Weapon.Name == "[Silencer]" and Weapon:FindFirstChild("Part") then
            Weapon.Part.Transparency = 0
        end
        
        if Weapon.Handle then
            Weapon.Handle:SetAttribute("SkinName", "")
            RestoreOriginalSound(Weapon)
        end
    end
    
    local function ApplyKnifeSkin(Weapon, Skin, Table)
        if not Weapon or not Weapon:FindFirstChild("Default") then
            return false
        end
        
        Weapon.Default:ClearAllChildren()
        
        local SkinMesh = Knives:FindFirstChild(Skin)
        if SkinMesh then
            local Mesh = SkinMesh:Clone()
            Mesh.Name = "Mesh"
            Mesh.Parent = Weapon.Default
            Weapon.Default.Transparency = 1
            
            local holdCFrame = KnifeCFrameData[Skin] or (Table and Table.CFrame) or CFrame.new()
            AttachKnifeMesh(Weapon.Default, Mesh, holdCFrame)
        end
        
        if Weapon.Handle then
            Weapon.Handle:SetAttribute("SkinName", Skin)
        end

        if Weapon.Parent == client.Character then
            PlayKnifeEquip(Weapon)
        end
        
        return true
    end
    
    local function ApplySkinVisual(Weapon, Skin, Table)
        if not Weapon or not Weapon:FindFirstChild("Default") then 
            return false 
        end
        
        if Weapon.Name == "[Knife]" then
            return ApplyKnifeSkin(Weapon, Skin, Table)
        end
        
        if not OriginalTextures[Weapon.Name] then
            OriginalTextures[Weapon.Name] = Weapon.Default.TextureID
        end
        
        for i,v in pairs(Weapon.Default:GetChildren()) do 
            if v:IsA("ParticleEmitter") then 
                v:Destroy() 
            end 
        end
        
        if Weapon.Name == "[Silencer]" then
            if Weapon:FindFirstChild("Part") then
                Weapon.Part.Transparency = 0
            end
        end
        
        if Table and typeof(Table.TextureID) == "string" then
            Weapon.Default.TextureID = Table.TextureID
            Weapon.Default.Transparency = 0
            Weapon.Default:ClearAllChildren()
        elseif Table and Weapon.Name == "[Wallet]" then
            for i, v in pairs(Weapon:GetDescendants()) do if v.Name == Skin then Weapon.Handle:SetAttribute("SkinName", Skin) return true end end
            local Wallets = SkinModules.Wallets
            local Mesh = Wallets:FindFirstChild(Skin)
            if Mesh then
                Mesh = Mesh:Clone()
                local Weld = Instance.new("Weld", Mesh)
                Mesh.Name = "Mesh"
                Weapon.C1.Transparency = 1
                Weapon.C2.Transparency = 1
                for i,v in Weapon.C1:GetChildren() do if v:IsA("Decal") then v.Transparency = 1 end end
                for i,v in Weapon.C2:GetChildren() do if v:IsA("Decal") then v.Transparency = 1 end end
                Weapon.Default.Transparency = 1
                Weld.C0 = SkinsList[Weapon.Name][Skin].CFrame
                Weld.Part0 = Weapon.Default
                Weld.Part1 = Mesh
                Mesh.Parent = Weapon.Default
            end
        elseif Table and Weapon.Name == "[Bat]" then
            for i, v in pairs(Weapon:GetDescendants()) do if v.Name == Skin then Weapon.Handle:SetAttribute("SkinName", Skin) return true end end
            local Bats = SkinModules.Bats
            local Mesh = Bats:FindFirstChild(Skin)
            if Mesh then
                Mesh = Mesh:Clone()
                local Weld = Instance.new("Weld", Mesh)
                Mesh.Name = "Mesh"
                Weapon.Default.Transparency = 1
                Weapon.Handle.Transparency = 1
                for i,v in Weapon.Default:GetChildren() do if v:IsA("Decal") then v.Transparency = 1 end end
                for i,v in Weapon.Handle:GetChildren() do if v:IsA("Decal") then v.Transparency = 1 end end
                Weapon.Default.Transparency = 1
                Weld.C0 = SkinsList[Weapon.Name][Skin].CFrame
                Weld.Part0 = Weapon.Default
                Weld.Part1 = Mesh
                Mesh.Parent = Weapon.Default
            end
        elseif Table then
            for i, v in pairs(Weapon:GetDescendants()) do if v.Name == Skin then Weapon.Handle:SetAttribute("SkinName", Skin) return true end end
            for _, x in Weapon:GetDescendants() do if (not x:IsA("MeshPart") or x.Name == Skin or x.Name == "Default") then continue end x:Destroy() end
            task.wait()
            Weapon.Default.TextureID = "rbxassetid://515583300"
            local Mesh = Table.TextureID:Clone()
            local Weld = Instance.new("Weld", Mesh)
            Mesh.Name = "Mesh"
            Weapon.Default.Transparency = 1
            Weld.C0 = SkinsList[Weapon.Name][Skin].CFrame
            Weld.Part0 = Weapon.Default
            Weld.Part1 = Mesh
            Mesh.Parent = Weapon.Default
        end
        
        if Weapon.Handle then
            Weapon.Handle:SetAttribute("SkinName", Skin)
        end
        return true
    end
    
