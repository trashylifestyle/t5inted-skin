        if not Weapon then return false end
        
        StoreOriginalSound(Weapon)
        StoreOriginalTexture(Weapon)
        
        local success = ApplySkinVisual(Weapon, Skin, Table)
        
        if success then
            ApplyCustomSound(Weapon, Skin)
        end
        
        return success
    end
    
    local function UpdateSkinUnlock()
        pcall(function()
            local playerGui = client:FindFirstChild("PlayerGui")
            if not playerGui then return end
            
            local mainGui = playerGui:FindFirstChild("MainScreenGui")
            if not mainGui then return end
            
            local weaponSkinsGui = mainGui:FindFirstChild("WeaponSkinsGUI")
            if not weaponSkinsGui then return end
            
            local body = weaponSkinsGui:FindFirstChild("Body")
            if not body then return end
            
            local wrapper = body:FindFirstChild("Wrapper")
            if not wrapper then return end
            
            local skinView = wrapper:FindFirstChild("SkinView")
            if not skinView then return end
            
            local frame = skinView:FindFirstChild("Frame")
            if not frame then return end
            
            local skins = frame:FindFirstChild("Skins")
            if not skins then return end
            
            local contents = skins:FindFirstChild("Contents")
            if not contents then return end
            
            local entries = contents:FindFirstChild("Entries")
            if not entries then return end
            
            local dataFolder = client:FindFirstChild("DataFolder")
            if not dataFolder then return end
            
            local skinsValue = dataFolder:FindFirstChild("Skins")
            if skinsValue then
                local success, ownedSkins = pcall(HttpService.JSONDecode, HttpService, skinsValue.Value)
                if success and type(ownedSkins) == "table" then
                    for _, skinFrame in ipairs(entries:GetChildren()) do
                        if skinFrame:IsA("Frame") and skinFrame.Name ~= "SkinEntryTemplate" then
                            local weaponName = skinFrame.Name:match("%[(.-)%]")
                            if weaponName then
                                weaponName = "[" .. weaponName .. "]"
                                local skinDisplayName = skinFrame.Name:gsub("%[.-%]", "")
                                
                                local preview = skinFrame:FindFirstChild("Preview")
                                if preview then
                                    local lockLabel = preview:FindFirstChild("LockImageLabel")
                                    local amountValue = preview:FindFirstChild("AmountValue")
                                    local sellButton = skinFrame:FindFirstChild("SkinInfo")
                                    if sellButton then
                                        sellButton = sellButton:FindFirstChild("Container")
                                        if sellButton then
                                            sellButton = sellButton:FindFirstChild("SellButton")
                                        end
                                    end
                                    
                                    local owns = ownedSkins[weaponName] and ownedSkins[weaponName][skinDisplayName]
                                    
                                    if owns and owns > 0 then
                                        if lockLabel then lockLabel.Visible = false end
                                        if amountValue then
                                            amountValue.Visible = true
                                            amountValue.Text = "x" .. owns
                                        end
                                        if sellButton then sellButton.Visible = true end
                                    else
                                        if lockLabel then lockLabel.Visible = true end
                                        if amountValue then amountValue.Visible = false end
                                        if sellButton then sellButton.Visible = false end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            
            local equipSkins = dataFolder:FindFirstChild("Information")
            if equipSkins then
                equipSkins = equipSkins:FindFirstChild("EquipSkins")
                if equipSkins then
                    local success, equipped = pcall(HttpService.JSONDecode, HttpService, equipSkins.Value)
                    if success and type(equipped) == "table" then
                        for _, skinFrame in ipairs(entries:GetChildren()) do
                            if skinFrame:IsA("Frame") and skinFrame.Name ~= "SkinEntryTemplate" then
                                local preview = skinFrame:FindFirstChild("Preview")
                                if preview then
                                    local equippedBadge = preview:FindFirstChild("Equipped")
                                    if equippedBadge then
                                        equippedBadge.Visible = false
                                    end
                                end
                            end
                        end
                        
                        for weaponName, skinName in pairs(equipped) do
                            if skinName ~= false then
                                for _, skinFrame in ipairs(entries:GetChildren()) do
                                    if skinFrame:IsA("Frame") and skinFrame.Name == weaponName .. skinName then
                                        local preview = skinFrame:FindFirstChild("Preview")
                                        if preview then
                                            local equippedBadge = preview:FindFirstChild("Equipped")
                                            if equippedBadge then
                                                equippedBadge.Visible = true
                                            end
                                        end
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    local function UpdateEquipSkins(weaponName, skinName)
        pcall(function()
            local dataFolder = client:FindFirstChild("DataFolder")
            if not dataFolder then return end
            local information = dataFolder:FindFirstChild("Information")
            if not information then return end
            
            local equipSkins = information:FindFirstChild("EquipSkins")
            if not equipSkins then
                equipSkins = Instance.new("StringValue")
                equipSkins.Name = "EquipSkins"
                equipSkins.Value = "{}"
                equipSkins.Parent = information
            end
            
            local equipped = {}
            local currentValue = equipSkins.Value
            if currentValue ~= "" and currentValue ~= "[]" then
                local success, decoded = pcall(HttpService.JSONDecode, HttpService, currentValue)
                if success and type(decoded) == "table" then
                    equipped = decoded
                end
            end
            
            if skinName then
                equipped[weaponName] = skinName
            else
                equipped[weaponName] = false
            end
            
            equipSkins.Value = HttpService:JSONEncode(equipped)
            
            UpdateSkinUnlock()
        end)
    end
    
    local function GiveAllSkins()
        local dataFolder = client:FindFirstChild("DataFolder")
        if not dataFolder then return false end
        
        local startTime = tick()
        repeat
            task.wait(0.1)
            if tick() - startTime > 120 then
                cout('GiveAllSkins', 'Timeout waiting for LOAD_SAVE_DATA')
                return false
            end
        until client:FindFirstChild("LOAD_SAVE_DATA")
        
        local DataTable = {}
        local AmountOfSkins = 1
        
        for weaponName, weaponSkins in pairs(SkinsList) do
            DataTable[weaponName] = {}
            for skinName, _ in pairs(weaponSkins) do
                DataTable[weaponName][skinName] = AmountOfSkins
            end
        end
        
        local skinsValue = dataFolder:FindFirstChild("Skins")
        if skinsValue then
            skinsValue.Value = HttpService:JSONEncode(DataTable)
            cout('Loading......')
            UpdateSkinUnlock()
            return true
        end
        return false
    end
    
    local function FindWeapon(weaponName, instance)
        if not instance then return nil end
        for _, v in ipairs(instance:GetChildren()) do
            if v:IsA('Tool') and v.Name == weaponName then
                return v
            end
        end
        return nil
    end

    OnToolEquipped = function(tool)
        if tool:IsA("Tool") and (tool:FindFirstChild("GunScript") or tool.Name == "[Knife]") then
            local skinName = InventoryChanger.Selected[tool.Name]
            
            if PendingSkinChanges[tool.Name] then
                skinName = PendingSkinChanges[tool.Name]
                PendingSkinChanges[tool.Name] = nil
            end
            
            if skinName then
                local Table = nil
                if SkinsList[tool.Name] then
                    for i,v in pairs(SkinsList[tool.Name]) do
                        if i == skinName then
                            Table = v
                            break
                        end
                    end
                end
                if Table then
                    ApplyFullSkin(tool, skinName, Table)
                elseif tool.Name == "[Knife]" then
                    ApplyFullSkin(tool, skinName, {})
                end
            else
                ResetToDefault(tool)
            end
        end
    end
    
    InventoryChanger.Functions.Equip = function(weaponName, skinName)
        local currentSkin = InventoryChanger.Selected[weaponName]
        
        if skinName and currentSkin == skinName then
            skinName = nil
        end
        
        InventoryChanger.Selected[weaponName] = skinName
        UpdateEquipSkins(weaponName, skinName)
        
        local weapon = FindWeapon(weaponName, client.Character)
        
        if weapon then
            if skinName then
                PendingSkinChanges[weaponName] = skinName
            else
                PendingSkinChanges[weaponName] = nil
            end
            OnToolEquipped(weapon)
        else
            weapon = FindWeapon(weaponName, client.Backpack)
            if weapon then
                ResetToDefault(weapon)
            end
        end
        
        UpdateSkinUnlock()
    end
    
    local function OnToolUnequipped(tool)
        if tool:IsA("Tool") and (tool:FindFirstChild("GunScript") or tool.Name == "[Knife]") then
            ResetToDefault(tool)
        end
    end
    
    local function HookToolEvents(tool)
        if not tool:IsA("Tool") or not (tool:FindFirstChild("GunScript") or tool.Name == "[Knife]") then
            return
        end
        
        if getgenv().InventoryConnections[tool.Name .. "_Equipped"] then
            pcall(function() getgenv().InventoryConnections[tool.Name .. "_Equipped"]:Disconnect() end)
        end
        if getgenv().InventoryConnections[tool.Name .. "_Unequipped"] then
            pcall(function() getgenv().InventoryConnections[tool.Name .. "_Unequipped"]:Disconnect() end)
        end
        if getgenv().InventoryConnections[tool.Name .. "_Activated"] then
            pcall(function() getgenv().InventoryConnections[tool.Name .. "_Activated"]:Disconnect() end)
        end
        
        getgenv().InventoryConnections[tool.Name .. "_Equipped"] = tool.Equipped:Connect(function()
            OnToolEquipped(tool)
        end)
        
        getgenv().InventoryConnections[tool.Name .. "_Unequipped"] = tool.Unequipped:Connect(function()
            OnToolUnequipped(tool)
        end)

        if tool.Name == "[Knife]" then
            getgenv().InventoryConnections[tool.Name .. "_Activated"] = tool.Activated:Connect(function()
                PlayKnifeSlash(tool)
            end)
        end
    end
    
    local function HookAllTools()
        if client.Backpack then
            for _, tool in ipairs(client.Backpack:GetChildren()) do
                HookToolEvents(tool)
            end
        end
        
        if client.Character then
            for _, tool in ipairs(client.Character:GetChildren()) do
                HookToolEvents(tool)
            end
        end
    end
    
    local function HookSkinFrame(skinFrame)
        if not skinFrame:IsA("Frame") or skinFrame.Name == "SkinEntryTemplate" then
            return false
        end
        
        local button = skinFrame:FindFirstChild("Button")
        if not button then
            return false
        end
        
        local weaponName = skinFrame.Name:match("%[(.-)%]")
        if not weaponName then
            return false
        end
        
        weaponName = "[" .. weaponName .. "]"
        local skinDisplayName = skinFrame.Name:gsub("%[.-%]", "")
        
        if getgenv().InventoryConnections[skinFrame.Name] and type(getgenv().InventoryConnections[skinFrame.Name]) == "table" then
            for _, conn in ipairs(getgenv().InventoryConnections[skinFrame.Name]) do
                pcall(function() conn:Disconnect() end)
            end
        end
        
        getgenv().InventoryConnections[skinFrame.Name] = {}
        
        local function OnSkinClick()
            InventoryChanger.Functions.Equip(weaponName, skinDisplayName)
        end
        
        local conn = button.Activated:Connect(OnSkinClick)
        table.insert(getgenv().InventoryConnections[skinFrame.Name], conn)
        
        return true
    end
    
    local function HookAllSkins()
        pcall(function()
            local playerGui = client:FindFirstChild("PlayerGui")
            if not playerGui then return end
            
            local mainGui = playerGui:FindFirstChild("MainScreenGui")
            if not mainGui then return end
            
            local weaponSkinsGui = mainGui:FindFirstChild("WeaponSkinsGUI")
            if not weaponSkinsGui then return end
            
            local body = weaponSkinsGui:FindFirstChild("Body")
            if not body then return end
            
            local wrapper = body:FindFirstChild("Wrapper")
            if not wrapper then return end
            
            local skinView = wrapper:FindFirstChild("SkinView")
            if not skinView then return end
            
            local frame = skinView:FindFirstChild("Frame")
            if not frame then return end
            
            local skins = frame:FindFirstChild("Skins")
            if not skins then return end
            
            local contents = skins:FindFirstChild("Contents")
            if not contents then return end
            
            local entries = contents:FindFirstChild("Entries")
            if not entries then return end
            
            for _, skinFrame in ipairs(entries:GetChildren()) do
                HookSkinFrame(skinFrame)
            end
            
            if not getgenv().InventoryConnections.EntriesChildAdded then
                getgenv().InventoryConnections.EntriesChildAdded = entries.ChildAdded:Connect(function(newSkin)
                    task.wait(0.1)
                    HookSkinFrame(newSkin)
                    UpdateSkinUnlock()
                end)
            end
            
            UpdateSkinUnlock()
            GUIHooked = true
        end)
    end
    
    local function OnSkinsButtonClicked()
        task.wait(1)
        HookAllSkins()
        UpdateSkinUnlock()
    end
    
    local function WatchForSkinsButton()
        pcall(function()
            local playerGui = client:WaitForChild("PlayerGui")
            local mainGui = playerGui:WaitForChild("MainScreenGui")
            local crew = mainGui:WaitForChild("Crew")
            local bottomLeft = crew:WaitForChild("BottomLeft").Frame
            local skinsButton = bottomLeft:WaitForChild("Skins")
            
            if getgenv().InventoryConnections.SkinsButton then
                pcall(function() getgenv().InventoryConnections.SkinsButton:Disconnect() end)
            end
            
            getgenv().InventoryConnections.SkinsButton = skinsButton.Activated:Connect(OnSkinsButtonClicked)
        end)
    end
    
    local function OnCharacterAdded(character)
        local function OnCharacterFullyLoaded()
            task.wait(1)
            
            if client.Backpack then
                for _, tool in ipairs(client.Backpack:GetChildren()) do
                    if tool:IsA("Tool") and (tool:FindFirstChild("GunScript") or tool.Name == "[Knife]") then
                        ResetToDefault(tool)
                    end
                end
            end
            
            if client.Character then
                for _, tool in ipairs(client.Character:GetChildren()) do
                    if tool:IsA("Tool") and (tool:FindFirstChild("GunScript") or tool.Name == "[Knife]") then
                        OnToolEquipped(tool)
                    end
                end
            end
            
            HookAllTools()
            WatchForSkinsButton()
            UpdateSkinUnlock()
            
            pcall(function()
                if client.PlayerGui:FindFirstChild("MainScreenGui") and 
                   client.PlayerGui.MainScreenGui:FindFirstChild("WeaponSkinsGUI") and
                   client.PlayerGui.MainScreenGui.WeaponSkinsGUI:FindFirstChild("Body") then
                    task.wait(1)
                    HookAllSkins()
                    UpdateSkinUnlock()
                end
            end)
        end
        
        if character:FindFirstChild("FULLY_LOADED_CHAR") then
            OnCharacterFullyLoaded()
        else
            local fullyLoadedConn
            fullyLoadedConn = character.ChildAdded:Connect(function(child)
                if child.Name == "FULLY_LOADED_CHAR" then
                    fullyLoadedConn:Disconnect()
                    OnCharacterFullyLoaded()
                end
            end)
        end
    end
    
    local function OnToolAdded(tool)
        if tool:IsA("Tool") and (tool:FindFirstChild("GunScript") or tool.Name == "[Knife]") then
            HookToolEvents(tool)
            if tool.Parent == client.Character then
                OnToolEquipped(tool)
            else
                ResetToDefault(tool)
            end
        end
    end
    
    local function WatchForTools()
        if client.Backpack then
            if getgenv().InventoryConnections.BackpackAdded then
                pcall(function() getgenv().InventoryConnections.BackpackAdded:Disconnect() end)
            end
            getgenv().InventoryConnections.BackpackAdded = client.Backpack.ChildAdded:Connect(OnToolAdded)
        end
        if client.Character then
            if getgenv().InventoryConnections.CharacterAdded then
                pcall(function() getgenv().InventoryConnections.CharacterAdded:Disconnect() end)
            end
            getgenv().InventoryConnections.CharacterAdded = client.Character.ChildAdded:Connect(OnToolAdded)
        end
    end
    
    local function WaitForDataFolder()
        local startTime = tick()
        repeat
            local dataFolder = client:FindFirstChild("DataFolder")
            if dataFolder then
                local skinsValue = dataFolder:FindFirstChild("Skins")
                if skinsValue then
                    return dataFolder
                end
            end
            task.wait(0.1)
            if tick() - startTime > 120 then
                cout('Timeout waiting for data')
                return nil
            end
        until false
    end
    
    local function init()
        local dataFolder = WaitForDataFolder()
        if not dataFolder then
            return
        end
        
        GiveAllSkins()
        
        WatchForSkinsButton()
        WatchForTools()
        
        client.CharacterAdded:Connect(function(char)
            WatchForTools()
            OnCharacterAdded(char)
        end)
        
        pcall(function()
            local playerGui = client:WaitForChild("PlayerGui")
            playerGui.ChildAdded:Connect(function(child)
                if child.Name == "MainScreenGui" then
                    task.wait(0.5)
                    WatchForSkinsButton()
                    HookAllSkins()
                end
            end)
        end)
        
        if client.Character then
            OnCharacterAdded(client.Character)
        end
        
        cout('Skin changer loaded. Click any skin to equip')
    end
    
    pcall(init)
end
