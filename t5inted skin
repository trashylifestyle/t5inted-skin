        if not OriginalTextures[Weapon.Name] then
            OriginalTextures[Weapon.Name] = Weapon.Default.TextureID
        end
    end
    
    local function RestoreOriginalSound(Weapon)
        if not Weapon or not Weapon.Handle then return end
        local ShootSound = Weapon.Handle:FindFirstChild('ShootSound')
        if not ShootSound then return end
        
        if OriginalSounds[Weapon.Name] then
            ShootSound.SoundId = OriginalSounds[Weapon.Name]
        end
