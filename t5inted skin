    local function StopKnifeAnimations(tool)
        if ActiveKnifeTracks[tool] then
            for _, track in ipairs(ActiveKnifeTracks[tool]) do
                pcall(function()
                    track:Stop(0.1)
                    track:Destroy()
                end)
            end
            ActiveKnifeTracks[tool] = nil
        end
    end

    local function PlayKnifeSound(tool, soundId)
        if not soundId or not tool then return end
        local handle = tool:FindFirstChild("Handle")
        if not handle then return end
        local sound = Instance.new("Sound")
        sound.SoundId = soundId
        sound.Parent = handle
        sound:Play()
        Debris:AddItem(sound, 3)
    end

    local function PlayKnifeEquip(tool)
        if not tool or tool.Name ~= "[Knife]" then return end
        StopKnifeAnimations(tool)

        local skin = InventoryChanger.Selected["[Knife]"] or (tool:FindFirstChild("Handle") and tool.Handle:GetAttribute("SkinName"))
        if not skin or skin == "" then return end

        local animData = KnifeAnimData[skin]
        if not animData then return end

        if animData.EquipSound then
            PlayKnifeSound(tool, animData.EquipSound)
        end

        if animData.Equip then
            local char = tool.Parent
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            if animator then
                local anim = Instance.new("Animation")
                anim.AnimationId = animData.Equip
                local ok, track = pcall(function()
                    return animator:LoadAnimation(anim)
                end)
                anim:Destroy()
                if ok and track then
                    track.Priority = Enum.AnimationPriority.Action
                    track.Looped = false
                    track:Play(0.1)
                    ActiveKnifeTracks[tool] = { track }
                end
            end
        end
    end

    local function PlayKnifeSlash(tool)
        if not tool or tool.Name ~= "[Knife]" then return end

        local skin = InventoryChanger.Selected["[Knife]"] or (tool:FindFirstChild("Handle") and tool.Handle:GetAttribute("SkinName"))
        if not skin or skin == "" then return end

        local animData = KnifeAnimData[skin]
        if not animData then return end

        if animData.SlashSound then
            PlayKnifeSound(tool, animData.SlashSound)
        end

        if animData.Slash then
            local char = tool.Parent
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            if animator then
                local anim = Instance.new("Animation")
                anim.AnimationId = animData.Slash
                local ok, track = pcall(function()
                    return animator:LoadAnimation(anim)
                end)
                anim:Destroy()
                if ok and track then
                    track.Priority = Enum.AnimationPriority.Action4
                    track.Looped = false
                    track:Play(0.1)
                    ActiveKnifeTracks[tool] = ActiveKnifeTracks[tool] or {}
                    table.insert(ActiveKnifeTracks[tool], track)
                end
            end
        end
    end

    local function AttachKnifeMesh(default, mesh, holdCFrame)
        if mesh:IsA("BasePart") then
            mesh.Anchored = false
            mesh.CanCollide = false
            mesh.Massless = true
            for _, desc in ipairs(mesh:GetDescendants()) do
                if desc:IsA("BasePart") then
                    desc.Anchored = false
                    desc.CanCollide = false
                    desc.Massless = true
                end
            end
            local weld = Instance.new("Weld")
            weld.Part0 = default
            weld.Part1 = mesh
            weld.C0 = holdCFrame
            weld.Parent = mesh
        elseif mesh:IsA("Model") then
            local primary = mesh.PrimaryPart or mesh:FindFirstChildWhichIsA("BasePart", true)
            if primary then
                for _, desc in ipairs(mesh:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        desc.Anchored = false
                        desc.CanCollide = false
                        desc.Massless = true
                        if desc ~= primary and not desc:FindFirstChildWhichIsA("JointInstance") and not desc:FindFirstChildWhichIsA("WeldConstraint") then
                            local subWeld = Instance.new("WeldConstraint")
                            subWeld.Part0 = primary
                            subWeld.Part1 = desc
                            subWeld.Parent = desc
                        end
                    end
                end
                local weld = Instance.new("Weld")
                weld.Part0 = default
                weld.Part1 = primary
                weld.C0 = holdCFrame
                weld.Parent = primary
            end
        end
    end
    
